{
  "name": "gw2-visualizer",
  "version": "0.11.0",
  "private": true,
  "license": "MIT",
  "description": "GW2 Visualizer: interactive Guild Wars 2 crafting tree explorer (static web app, built with Vite).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "vite --open",
    "serve": "vite",
    "dev:local": "vite --mode engines",
    "build": "vite build && node tools/build-site.mjs",
    "preview": "vite preview",
    "check": "node tools/check.mjs",
    "check:svelte": "svelte-check --tsconfig ./jsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.js\"",
    "verify": "npm run check && npm run check:svelte && npm run lint && npm run format:check && npm test",
    "icons": "node tools/generate-icons.mjs",
    "update-forge": "node tools/update-mystic-forge.mjs",
    "format": "prettier --write \"**/*.{js,mjs,css,svelte}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,css,svelte}\"",
    "snapshot": "node tools/build-data-snapshot.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "eslint": "^10.0.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "^17.12.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "prism": "github:BrettWhitson/prism#v0.3.2",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tether": "github:BrettWhitson/tether#v0.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0"
  }
}
