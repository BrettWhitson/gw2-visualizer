{
  "name": "gw2-visualizer",
  "version": "0.10.0",
  "private": true,
  "license": "MIT",
  "description": "GW2 Visualizer: interactive Guild Wars 2 crafting tree explorer (static web app, built with Vite).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "vite --open",
    "serve": "vite",
    "dev:local": "vite --mode engines",
    "build": "vite build && node tools/build-site.mjs",
    "preview": "vite preview",
    "check": "node tools/check.mjs",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.js\"",
    "verify": "npm run check && npm run lint && npm run format:check && npm test",
    "icons": "node tools/generate-icons.mjs",
    "update-forge": "node tools/update-mystic-forge.mjs",
    "format": "prettier --write \"**/*.{js,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,css}\"",
    "snapshot": "node tools/build-data-snapshot.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "globals": "^17.12.0",
    "prettier": "3.9.9",
    "prism": "github:BrettWhitson/prism#e0162e37cef97dc2ebea475ce72be00b59fcd0ac",
    "tether": "github:BrettWhitson/tether#72200e70f4cdf5467b0ea1c3f64bb0904f791e87",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0"
  }
}
